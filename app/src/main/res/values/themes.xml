<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gal" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.Gal.Base</item>
    </style>
    <style name="Theme.Gal.Base" parent="Theme.AppCompat.DayNight.NoActionBar" />
    <!-- External viewer: no splash, black window so nothing flashes before the photo -->
    <style name="Theme.Gal.Viewer" parent="Theme.Gal.Base">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
